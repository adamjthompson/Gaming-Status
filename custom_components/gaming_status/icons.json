{
  "triggers": {
    "session_started": {
      "trigger": "mdi:controller"
    },
    "session_switched": {
      "trigger": "mdi:swap-horizontal"
    },
    "session_ended": {
      "trigger": "mdi:controller-off"
    },
    "screen_time_exceeded": {
      "trigger": "mdi:timer-alert-outline"
    },
    "curfew_exceeded": {
      "trigger": "mdi:weather-night"
    },
    "rating_exceeded": {
      "trigger": "mdi:shield-alert-outline"
    },
    "achievement_unlocked": {
      "trigger": "mdi:trophy"
    }
  }
}
